+  nivel?: string;
+  mensagem?: string;
+}
+
+// ── Labels ─────────────────────────────────────────────────────────────────────
+
+const TRIGGER_OPTIONS: { value: TriggerTipo; label: string; descricao: string }[] = [
+  { value: "comment_keyword", label: "Palavra-chave no comentário", descricao: "Dispara quando o comentário contém uma ou mais palavras-chave." },
