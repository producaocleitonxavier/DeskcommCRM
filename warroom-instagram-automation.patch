+
+const ACAO_OPTIONS: { value: AcaoTipo; label: string; descricao: string }[] = [
+  { value: "enviar_dm", label: "Enviar DM", descricao: "Envia mensagem direta para quem comentou. Variáveis: {{username}}, {{comentario}}" },
