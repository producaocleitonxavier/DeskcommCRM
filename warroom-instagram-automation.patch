+ *
+ * Acesso: manager+
+ */
+
+"use client";
+
+import { useState } from "react";
+import { useRouter } from "next/navigation";
+import Link from "next/link";
+
+// ── Tipos ──────────────────────────────────────────────────────────────────────
+
+type TriggerTipo =
+  | "comment_keyword"
+  | "comment_no_post"
